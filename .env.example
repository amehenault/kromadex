DATABASE_URL=colle-ici-la-connection-string-neon

# Courriels (mot de passe oublié) : même compte Resend que Planidae
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM="Kromadex <noreply@amelacoloree.com>"
# Une fois kromadex.com vérifié chez Resend : EMAIL_FROM="Kromadex <info@kromadex.com>"
# Adresse où arrivent les réponses (par défaut info@kromadex.com)
EMAIL_REPLY_TO=info@kromadex.com

# Kromadex+ : mot secret ThriveCart (Settings > API & webhooks), vérifie que les avis de paiement viennent bien de ThriveCart
THRIVECART_SECRET=ton-mot-secret-thrivecart

# Tâche planifiée quotidienne (vercel.json) : rappels et nettoyage des données
CRON_SECRET=un-long-mot-secret
# Nettoyage automatique des données : « actif » pour supprimer vraiment, sinon simulation (compte seulement)
NETTOYAGE_AUTO=
